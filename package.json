{
  "name": "badawi-shop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "test:db": "node supabase/tests/schema.test.mjs && node supabase/tests/schema-once.test.mjs",
    "test:all": "npm run test && npm run test:db",
    "sync:wasm": "node -e \"require('fs').copyFileSync('node_modules/zxing-wasm/dist/reader/zxing_reader.wasm','public/zxing_reader.wasm')\"",
    "prebuild": "npm run sync:wasm",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && node scripts/build-apk.mjs",
    "setup": "node scripts/setup.mjs",
    "docs:screens": "node scripts/capture-screens.mjs",
    "docs:manual": "node scripts/build-manual.mjs",
    "docs": "npm run docs:screens && npm run docs:manual"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.112.4",
    "exceljs": "^4.4.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@electric-sql/pglite": "^0.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
